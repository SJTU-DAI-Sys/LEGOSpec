{
  "architectures": [
    "ComposableDraftModel"
  ],
  "block_size": 8,
  "schema_version": "composable_v3",
  "composable_config": {
    "context": {
      "type": "dflash",
      "target_layer_ids": [
        1,
        9,
        17,
        25,
        33
      ]
    },
    "backbone": {
      "type": "layer_stack",
      "layers": [
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "dense",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        }
      ]
    },
    "proposal": {
      "type": "rnn",
      "rank": 256
    },
    "objective": {
      "type": "dpal_renyi",
      "rho": 0.3,
      "reduction": "complete_block_mean",
      "loss_decay_gamma": null
    },
    "access_configs": {
      "sliding_window": {
        "window_size": 512
      },
      "dense": {}
    },
    "attention_configs": {
      "gqa": {
        "num_attention_heads": 32,
        "num_key_value_heads": 8,
        "head_dim": 128
      }
    }
  }
}
