-    def forward(self, x, z):
-        dtype = x.dtype
-        x = x.float()
-        x = x * torch.rsqrt(x.square().mean(-1, keepdim=True) + self.eps)
-        x = self.weight * x.to(dtype)
-        return (x * F.silu(z.float())).to(dtype)
