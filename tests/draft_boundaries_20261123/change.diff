-    rotated = torch.cat(
-        (
-            first * angles.cos() - second * angles.sin(),
-            second * angles.cos() + first * angles.sin(),
-        ),
-        -1,
-    )
-    return torch.cat((rotated.to(x.dtype), x[..., width:]), -1)
