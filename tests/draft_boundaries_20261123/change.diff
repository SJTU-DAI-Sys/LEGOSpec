-    keep = complete[..., None, None]
-    q = torch.where(keep, draft_logits, 0).float().softmax(-1)
-    p = torch.where(keep, target_logits.detach(), 0).float().softmax(-1)
-    return (1 - 0.5 * (p - q).abs().sum(-1)).clamp(0, 1)
